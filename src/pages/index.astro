---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { HOME_TITLE, HOME_DESCRIPTION } from '../consts';

const site = Astro.site!.href;
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': `${site}#organization`,
			name: 'Coobeeyon Development Limited',
			alternateName: 'Coobeeyon',
			url: site,
			logo: new URL('/logo.png', site).href,
			email: 'mike.daum@coobeeyon.net',
			description: HOME_DESCRIPTION,
			address: {
				'@type': 'PostalAddress',
				addressLocality: 'Toronto',
				addressRegion: 'ON',
				addressCountry: 'CA',
			},
			founder: { '@id': `${site}#michael-daum` },
		},
		{
			'@type': 'Person',
			'@id': `${site}#michael-daum`,
			name: 'Michael Daum',
			jobTitle: 'Software developer and consultant',
			url: new URL('/about/', site).href,
			worksFor: { '@id': `${site}#organization` },
			homeLocation: { '@type': 'Place', name: 'Toronto, Ontario, Canada' },
			sameAs: ['https://github.com/coobeeyon'],
		},
		{
			'@type': 'WebSite',
			'@id': `${site}#website`,
			name: 'Coobeeyon Development',
			url: site,
			publisher: { '@id': `${site}#organization` },
		},
		{
			'@type': 'Event',
			name: 'Is C++ Turing Complete?',
			description:
				'A 60-minute Core C++ 2026 talk by Michael Daum: six computational worlds inside C++ go on trial, from runtime code and templates to constant evaluation, CTAD, the preprocessor, and a contracts machine.',
			startDate: '2026-10-20',
			endDate: '2026-10-21',
			eventStatus: 'https://schema.org/EventScheduled',
			eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
			location: {
				'@type': 'Place',
				name: 'Tel Aviv Cinematheque',
				address: { '@type': 'PostalAddress', addressLocality: 'Tel Aviv', addressCountry: 'IL' },
			},
			superEvent: { '@type': 'Event', name: 'Core C++ 2026', url: 'https://corecpp.org/' },
			performer: { '@id': `${site}#michael-daum` },
			organizer: { '@type': 'Organization', name: 'Core C++', url: 'https://corecpp.org/' },
		},
	],
};
---

<html lang="en">
	<head>
		<BaseHead title={HOME_TITLE} description={HOME_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<Header />

		<main>
			<h1>Coobeeyon Development Limited</h1>
			<p><i>Useful software for difficult problems.</i></p>

			<hr />

			<section class="talk-callout" aria-labelledby="talk-title">
				<p class="blink"><b>UPCOMING AT CORE C++ 2026</b></p>
				<h2 id="talk-title">Is C++ Turing Complete?</h2>
				<p><b>October 20–21 · Tel Aviv · 60 minutes</b></p>
				<p>
					Six different computational worlds inside C++ go on trial—from ordinary
					runtime code and templates to constant evaluation, CTAD, the preprocessor,
					and an intentionally strange contracts machine. The main path stays playful;
					the complete proofs and their limits sit underneath.
				</p>
			</section>

			<h2>New: AirTime for iPhone</h2>
			<p>
				<a href="/airtime/"
					><img
						src="/airtime/airtime-icon-192.png"
						alt="AirTime app icon"
						width="64"
						height="64"
						align="middle"
					/></a
				>
				<a href="/airtime/"><b>AirTime</b></a>
			</p>
			<p>
				AirTime shows who’s doing all the talking: each speaker’s estimated airtime and
				who spoke when, analyzed on your iPhone. No transcript, no account.
				<a href="/airtime/">See how it works</a>.
			</p>

			<h2>What I do</h2>
			<p>
				Coobeeyon is the consulting practice of <b>Michael Daum</b>, a software
				developer in Toronto. I work directly with clients on hard product and
				engineering problems. When a project needs more people, I bring in seasoned
				specialists I trust.
			</p>
			<p>
				I am especially drawn to rich graphical interfaces, useful artificial
				intelligence, complex data, and software that has to work in the real world.
			</p>

			<h2>Selected client work</h2>
			<h3>Interactive construction planning</h3>
			<p>
				A browser-based planning system that turns complex construction drawings into
				structured project data, makes plan options explorable, and applies useful AI
				to difficult planning work.
			</p>
			<h3>Three-dimensional electrical design</h3>
			<p>
				A rich 3D application for electrical design, from model conversion and custom
				rendering to precise editing of generated conduit routes and visual diagnostics.
			</p>
			<p>
				<a href="/work">See more client work</a>, including software for semiconductor
				testing, human resources, and field-service operations.
			</p>

			<h2>Selected experiments &amp; obsessions</h2>
			<ul>
				<li>
					<a href="https://farcaster.xyz/coobeeyon"><b>Stigmergence:</b></a>
					An autonomous agent exploring generative art and the market.
				</li>
				<li>
					<a href="https://github.com/coobeeyon/Asteroids"><b>Genetic Asteroids:</b></a>
					Evolution revolution.
				</li>
			</ul>

			<h2>Tools for working with coding agents</h2>
			<ul>
				<li>
					<a href="https://github.com/coobeeyon/litebrite"><b>litebrite:</b></a>
					A small task tracker that gives people and coding agents one shared view of the work.
				</li>
				<li>
					<a href="https://github.com/coobeeyon/mrmouth"><b>mrmouth:</b></a>
					A supervisor that plans bounded jobs, runs coding agents in containers, and checks
					the result.
				</li>
				<li>
					<a href="https://github.com/coobeeyon/trapperkeeper"><b>trapperkeeper:</b></a>
					A project wiki that keeps decisions and working knowledge close to the code.
				</li>
			</ul>

			<p>
				Learn more <a href="/about">about Coobeeyon</a>, or
				<a href="mailto:mike.daum@coobeeyon.net">send me a note</a>.
			</p>
		</main>

		<Footer />
	</body>
</html>
