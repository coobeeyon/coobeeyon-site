---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: string;
	/** Alt text for the share image. */
	imageAlt?: string;
	/** Favicon; defaults to the site icon. */
	icon?: string;
	/** Use 'summary_large_image' with a 1200x630 share image. */
	card?: 'summary' | 'summary_large_image';
	/** Open Graph site name. */
	siteName?: string;
	/** Home-screen icon for iOS. */
	touchIcon?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = '/coobeeyon-share-1200x630.png',
	imageAlt = 'Coobeeyon Development: Michael Daum, software and AI consulting in Toronto',
	icon = '/favicon.png',
	card = 'summary_large_image',
	siteName = SITE_TITLE,
	touchIcon = '/apple-touch-icon.png',
} = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href={icon} />
<link rel="apple-touch-icon" href={touchIcon} />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="en_CA" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
{card === 'summary_large_image' && <meta property="og:image:width" content="1200" />}
{card === 'summary_large_image' && <meta property="og:image:height" content="630" />}
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}

<!-- Twitter -->
<meta property="twitter:card" content={card} />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />
{imageAlt && <meta property="twitter:image:alt" content={imageAlt} />}
