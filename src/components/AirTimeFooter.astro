---
// Footer for the /airtime/ pages: AirTime links, then the maker's mark and legal lines.
const year = new Date().getFullYear();
---

<footer class="airtime-footer">
	<nav aria-label="AirTime">
		<a href="/airtime/privacy/">Privacy Policy</a>
		<a href="/airtime/support/">Support</a>
		<a href="https://www.apple.com/legal/internet-services/itunes/dev/stdeula/">Terms of Use</a>
		<a href="mailto:mike.daum@coobeeyon.net">mike.daum@coobeeyon.net</a>
	</nav>
	<div class="maker">
		<a href="https://coobeeyon.com/">
			<img src="/airtime/coobeeyon-logo-128.png" width="48" height="48" alt="Coobeeyon Development" />
		</a>
		<p>
			© {year} Coobeeyon Development Limited<br />
			AirTime is a trademark of Coobeeyon Development Limited.
		</p>
	</div>
</footer>

<style>
	.airtime-footer {
		max-width: 72rem;
		margin: 48px auto 0;
		padding: 24px 0 32px;
		border-top: 2px solid #e6d9bf;
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
		font-size: 15px;
		line-height: 1.5;
		color: #52656b;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 24px;
		margin-bottom: 24px;
	}

	nav a {
		padding: 4px 0;
	}

	.maker {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.maker p {
		margin: 0;
	}

	.maker img {
		display: block;
	}
</style>
