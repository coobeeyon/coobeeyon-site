---
// Small AirTime identity for the AirTime legal pages; links back to the landing page.
---

<header class="airtime-header">
	<a href="/airtime/">
		<img src="/airtime/airtime-icon-192.png" width="44" height="44" alt="" class="icon" />
		<img src="/airtime/airtime-wordmark.png" width="141" height="44" alt="AirTime" />
	</a>
</header>

<style>
	.airtime-header {
		max-width: 72rem;
		margin: 16px auto 8px;
	}

	a {
		display: inline-flex;
		align-items: center;
		gap: 12px;
	}

	.icon {
		border-radius: 10px;
		box-shadow: 0 0 0 1px #e6d9bf;
	}
</style>
